import numpy as np
import matplotlib.pyplot as plt

# preamble
samples = 50
y = []

# the loop
for i in range(1,samples+1):
    tmp_y = np.log(i)
    y.append(tmp_y)

# plotting the results
plt.plot(y,marker='o',color='b',linestyle='-')
plt.xlabel('Iteration')
plt.ylabel('Outcome Variable')
plt.show()





